      "section_title": "Limits & Continuity",
      "section_type": "formulas",
      "entries": [
        {
          "label": "Existence of Limit",
          "content": "$\\lim_{x\\to a^-} f(x) = \\lim_{x\\to a^+} f(x)$"
        },
        {
          "label": "Continuity Condition",
          "content": "$\\lim_{x\\to a} f(x) = f(a)$"
        },
        {
          "label": "IVT",
          "content": "$f$ cont. on $[a,b] \\implies \\forall N \\in (f(a), f(b)), \\exists c \\in (a,b) : f(c)=N$"
        },
        {
          "label": "Application",
          "content": "Apply this concept using a simple practice example."
        }
      ]
    },
    {
      "section_title": "Differentiation",
      "section_type": "formulas",
      "entries": [
        {
          "label": "Power Rule",
          "content": "$\\frac{d}{dx}x^n = nx^{n-1}$"
        },
        {
          "label": "Product Rule",
          "content": "$(fg)' = f'g + fg'$"
        },
        {
          "label": "Quotient Rule",
          "content": "$(\\frac{f}{g})' = \\frac{f'g - fg'}{g^2}$"
        },
        {
          "label": "Chain Rule",
          "content": "$\\frac{dy}{dx} = \\frac{dy}{du} \\cdot \\frac{du}{dx}$"
        },
        {
          "label": "Log Derivative",
          "content": "$\\frac{d}{dx}\\ln(x) = \\frac{1}{x}$"
        },
        {
          "label": "Exp Derivative",
          "content": "$\\frac{d}{dx}e^x = e^x$"
        }
      ]
    },
    {
      "section_title": "Integration",
      "section_type": "formulas",
      "entries": [
        {
          "label": "Power Rule",
          "content": "$\\int x^n dx = \\frac{x^{n+1}}{n+1} + C$"
        },
        {
          "label": "Integration by Parts",
          "content": "$\\int u dv = uv - \\int v du$"
        },
        {
          "label": "FTC Part 1",
          "content": "$\\frac{d}{dx}\\int_{a}^{x} f(t) dt = f(x)$"
        },
        {
          "label": "Definite Integral",
          "content": "$\\int_{a}^{b} f(x) dx = F(b) - F(a)$"
        },
        {
          "label": "Disk Method",
          "content": "$V = \\pi \\int_{a}^{b} [f(x)]^2 dx$"
        }
      ]
    }
